{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Executar AdegaSaaS",
            "type": "shell",
            "command": "${workspaceFolder}\\mvnw.cmd",
            "args": [
                "spring-boot:run",
                "-Dspring-boot.run.profiles=dev"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Testar AdegaSaaS",
            "type": "shell",
            "command": "${workspaceFolder}\\mvnw.cmd",
            "args": [
                "test"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Instalar dependências do front-end",
            "type": "shell",
            "command": "npm",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Executar front-end",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Compilar front-end",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
